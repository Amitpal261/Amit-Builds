# MongoDB connection string (MongoDB Atlas free tier works fine)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/amit-portfolio

# Secret used to sign admin session JWTs - make this long & random
JWT_SECRET=replace-this-with-a-long-random-string

# Admin login credentials
ADMIN_EMAIL=you@example.com
# Generate a hash with: node scripts/hash-password.mjs "yourpassword"
ADMIN_PASSWORD_HASH=

# Your WhatsApp number used in CTA buttons (with country code, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=8810654697

# Base site URL (used for metadata / SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
